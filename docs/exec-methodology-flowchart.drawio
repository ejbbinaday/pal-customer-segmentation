<mxfile host="app.diagrams.net" modified="2026-08-03T00:00:00.000Z" agent="manual" version="24.0.0" type="device">
  <diagram id="exec-methodology" name="Executive methodology">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="banner" value="&lt;b&gt;How we segment PAL&#39;s customers&lt;/b&gt; — business logic decides, machine learning verifies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=20;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1880" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="&lt;font style=&quot;font-size: 10px&quot; color=&quot;#2E5FA3&quot;&gt;&lt;b&gt;PREPARE THE DATA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Start with every ticket&lt;/b&gt;&lt;br&gt;&lt;br&gt;38 million ticket records,&lt;br&gt;May 2024 – May 2027 —&lt;br&gt;no personal or loyalty data required&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#4A5A70&quot;&gt;&lt;i&gt;Streamed at full scale with open-source tools; typed, cleaned, quality-flagged&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2E5FA3;strokeWidth=2;fontColor=#1B2A41;fontSize=13;align=center;verticalAlign=middle;arcSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="280" height="250" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="&lt;font style=&quot;font-size: 10px&quot; color=&quot;#2E5FA3&quot;&gt;&lt;b&gt;PREPARE THE DATA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Organise into trips and customers&lt;/b&gt;&lt;br&gt;&lt;br&gt;22.9M bookings across 13.4M customers —&lt;br&gt;one booking = one travel decision&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#4A5A70&quot;&gt;&lt;i&gt;Behaviour measured per booking: lead time, trip shape, routes, a 7-tier fare-value ladder&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2E5FA3;strokeWidth=2;fontColor=#1B2A41;fontSize=13;align=center;verticalAlign=middle;arcSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="290" height="250" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="&lt;font style=&quot;font-size: 10px&quot; color=&quot;#8A6400&quot;&gt;&lt;b&gt;THE DELIVERABLE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Sort every booking into 10 customer segments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transparent business rules — every assignment explainable in one sentence&lt;br&gt;e.g. Corporate · Overseas Workers · Family Visits (Balikbayan)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#6B5510&quot;&gt;&lt;i&gt;Rules won on evidence: 10 clustering algorithms found no natural clusters — so rules assign, machine learning verifies&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#A87900;strokeWidth=3;fontColor=#3D2E00;fontSize=13;align=center;verticalAlign=middle;arcSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="180" width="310" height="250" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6B4FA8&quot;&gt;&lt;b&gt;PROVE IT WORKS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Stress-test the segments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Four independent studies confirm the segments are real, predictive, and stable&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#4B3A78&quot;&gt;&lt;i&gt;Distinct on evidence the rules never saw · predict refunds &amp;amp; rebooking · hold across a 12-month step&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFB;strokeColor=#6B4FA8;strokeWidth=2;fontColor=#2A1B41;fontSize=13;align=center;verticalAlign=middle;arcSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="300" height="250" as="geometry" />
        </mxCell>

        <mxCell id="step5" value="&lt;font style=&quot;font-size: 10px&quot; color=&quot;#2E8B57&quot;&gt;&lt;b&gt;IN YOUR HANDS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · Deliver live dashboards&lt;/b&gt;&lt;br&gt;&lt;br&gt;Interactive Power BI — every figure traceable back to source tickets&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#2A5B41&quot;&gt;&lt;i&gt;All 38.1M rows reconciled on every build; drift monitoring specified&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6EC;strokeColor=#2E8B57;strokeWidth=2;fontColor=#0F2E1D;fontSize=13;align=center;verticalAlign=middle;arcSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1380" y="180" width="260" height="250" as="geometry" />
        </mxCell>

        <mxCell id="step6" value="&lt;font style=&quot;font-size: 10px&quot; color=&quot;#C0455A&quot;&gt;&lt;b&gt;WHAT WE NEED FROM YOU&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;6 · PAL expert sign-off&lt;/b&gt;&lt;br&gt;&lt;br&gt;Your commercial team reviews ~1,000 bookings to confirm the segment names fit the business&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#8A3040&quot;&gt;&lt;i&gt;Scored on the business cost of each misclassification, not raw accuracy&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0455A;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#5A1F2A;fontSize=13;align=center;verticalAlign=middle;arcSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1680" y="180" width="240" height="250" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E5FA3;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E5FA3;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B4FA8;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E8B57;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C0455A;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="leg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2E5FA3;strokeWidth=2;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="24" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg1t" value="Prepare the data" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A5A70;" vertex="1" parent="1">
          <mxGeometry x="372" y="463" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#A87900;strokeWidth=2;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="530" y="470" width="24" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg2t" value="The deliverable: 10 segments" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A5A70;" vertex="1" parent="1">
          <mxGeometry x="562" y="463" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFB;strokeColor=#6B4FA8;strokeWidth=2;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="790" y="470" width="24" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg3t" value="Prove it works" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A5A70;" vertex="1" parent="1">
          <mxGeometry x="822" y="463" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6EC;strokeColor=#2E8B57;strokeWidth=2;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="970" y="470" width="24" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg4t" value="In your hands" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A5A70;" vertex="1" parent="1">
          <mxGeometry x="1002" y="463" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0455A;strokeWidth=2;dashed=1;dashPattern=4 3;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="1140" y="470" width="24" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg5t" value="What we need from you" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A5A70;" vertex="1" parent="1">
          <mxGeometry x="1172" y="463" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg6t" value="Italic line in each box = how it was done" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#4A5A70;" vertex="1" parent="1">
          <mxGeometry x="1390" y="463" width="260" height="30" as="geometry" />
        </mxCell>

        <mxCell id="footnote" value="&lt;i&gt;Behaviourally validated; segment names pending confirmation by PAL&#39;s commercial experts (step 6).&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#4A5A70;" vertex="1" parent="1">
